# PART E: MORTGAGE RATE ENRICHMENT
# ============================================================
print("=" * 55)
print("PART E: MORTGAGE RATE ENRICHMENT")
print("=" * 55)

print("Fetching MORTGAGE30US from FRED...")
url = "https://fred.stlouisfed.org/graph/fredgraph.csv?id=MORTGAGE30US"
mortgage = pd.read_csv(url, parse_dates=["observation_date"])
mortgage.columns = ["date", "rate_30yr_fixed"]
print(f"Fetched {len(mortgage):,} weekly observations")
print(f"Rate range: {mortgage['date'].min().date()} to {mortgage['date'].max().date()}")
print()

mortgage["year_month"] = mortgage["date"].dt.to_period("M")
mortgage_monthly = (
    mortgage.groupby("year_month")["rate_30yr_fixed"]
    .mean()
    .reset_index()
)
mortgage_monthly["rate_30yr_fixed"] = mortgage_monthly["rate_30yr_fixed"].round(2)
print("--- Monthly Mortgage Rates (sample) ---")
print(mortgage_monthly.tail(6).to_string(index=False))
print()

sold["year_month"]     = pd.to_datetime(sold["CloseDate"],             format="mixed").dt.to_period("M")
listings["year_month"] = pd.to_datetime(listings["ListingContractDate"], format="mixed").dt.to_period("M")

sold_enriched     = sold.merge(mortgage_monthly,     on="year_month", how="left")
listings_enriched = listings.merge(mortgage_monthly, on="year_month", how="left")

sold_null_rates     = sold_enriched["rate_30yr_fixed"].isnull().sum()
listings_null_rates = listings_enriched["rate_30yr_fixed"].isnull().sum()
print(f"Null rate values after merge - sold: {sold_null_rates}  |  listings: {listings_null_rates}")
if sold_null_rates == 0 and listings_null_rates == 0:
    print("Merge validation passed: no null rates.")
else:
    print("WARNING: Some rows did not match a mortgage rate.")
print()

print("--- Sold + Rate Preview ---")
print(sold_enriched[["CloseDate", "year_month", "ClosePrice",
                      "rate_30yr_fixed"]].head(5).to_string(index=False))
print()

