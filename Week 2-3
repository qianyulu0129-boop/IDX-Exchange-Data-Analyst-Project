def missing_value_report(df, label):
    total = len(df)
    null_counts = df.isnull().sum()
    null_pct    = (null_counts / total * 100).round(2)
    report = pd.DataFrame({
        "null_count": null_counts,
        "null_pct"  : null_pct
    }).sort_values("null_pct", ascending=False)

    print(f"\n--- {label}: Missing Value Report ---")
    print(report.to_string())

    high_missing = report[report["null_pct"] > 90]
    if not high_missing.empty:
        print(f"\n  Columns with >90% missing values ({len(high_missing)}):")
        for col in high_missing.index:
            print(f"    {col:40s}  {high_missing.loc[col,'null_pct']}% missing")
    else:
        print("  No columns above 90% missing threshold.")
    print()
    return report

