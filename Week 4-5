DATA_FOLDER   = "/Users/qianyulu/Desktop/IDXexchange"
OUTPUT_FOLDER = "/Users/qianyulu/Desktop/IDXexchange"

os.makedirs(OUTPUT_FOLDER, exist_ok=True)

# California coordinate bounds
LAT_MIN, LAT_MAX = 32.0, 42.5
LON_MIN, LON_MAX = -124.5, -114.0

# ============================================================
# STEP 1: Load datasets from Week 2-3
# ============================================================
print("=" * 55)
