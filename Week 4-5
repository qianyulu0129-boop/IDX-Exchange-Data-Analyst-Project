"""
Week 4-5 - Data Cleaning and Preparation
IDX Exchange MLS Analytics Program

Transformations documented:
1. Convert date fields to datetime
2. Remove redundant/duplicate columns
3. Handle missing values (drop >50% missing rows for key fields)
4. Ensure numeric fields are properly typed
5. Flag and remove invalid numeric values
6. Date consistency checks and flags
7. Geographic data quality flags
8. Save flagged dataset + clean analysis-ready dataset
"""

import pandas as pd
import numpy as np
import os

# ============================================================
# CONFIG
# ============================================================
DATA_FOLDER   = "/Users/qianyulu/Desktop/IDXexchange"
OUTPUT_FOLDER = "/Users/qianyulu/Desktop/IDXexchange"

os.makedirs(OUTPUT_FOLDER, exist_ok=True)

# California coordinate bounds
LAT_MIN, LAT_MAX = 32.0, 42.5
LON_MIN, LON_MAX = -124.5, -114.0

# ============================================================
# STEP 1: Load datasets from Week 2-3
# ============================================================
print("=" * 55)
print("STEP 1: LOADING DATASETS")
print("=" * 55)

sold     = pd.read_csv(os.path.join(DATA_FOLDER, "sold_enriched.csv"),     low_memory=False)
listings = pd.read_csv(os.path.join(DATA_FOLDER, "listings_enriched.csv"), low_memory=False)

sold_original_rows     = len(sold)
listings_original_rows = len(listings)

print(f"sold_enriched.csv     loaded: {len(sold):>7,} rows  x  {sold.shape[1]} columns")
print(f"listings_enriched.csv loaded: {len(listings):>7,} rows  x  {listings.shape[1]} columns")
print()

# ============================================================
# STEP 2: Remove redundant/duplicate columns
# ============================================================
print("=" * 55)
print("STEP 2: REMOVE REDUNDANT COLUMNS")
print("=" * 55)

# Why: duplicate .1 columns carry identical data and inflate column count
dup_cols_sold     = [c for c in sold.columns     if c.endswith(".1")]
dup_cols_listings = [c for c in listings.columns if c.endswith(".1")]

if dup_cols_sold:
    sold = sold.drop(columns=dup_cols_sold)
    print(f"Dropped {len(dup_cols_sold)} duplicate columns from sold: {dup_cols_sold}")
else:
    print("No duplicate columns found in sold.")

if dup_cols_listings:
    listings = listings.drop(columns=dup_cols_listings)
    print(f"Dropped {len(dup_cols_listings)} duplicate columns from listings: {dup_cols_listings}")
else:
    print("No duplicate columns found in listings.")
print()

# ============================================================
# STEP 3: Convert date fields to datetime
# ============================================================
print("=" * 55)
print("STEP 3: DATE FIELD CONVERSION")
print("=" * 55)

# Why: date fields are loaded as strings by default;
# must be datetime for comparison, flag creation, and time-series analysis

date_fields = [
    "CloseDate", "PurchaseContractDate",
    "ListingContractDate", "ContractStatusChangeDate"
]

for col in date_fields:
    if col in sold.columns:
        sold[col] = pd.to_datetime(sold[col], format="mixed", errors="coerce")
        print(f"  sold     [{col}] -> datetime  |  nulls: {sold[col].isnull().sum():,}")
    if col in listings.columns:
        listings[col] = pd.to_datetime(listings[col], format="mixed", errors="coerce")
        print(f"  listings [{col}] -> datetime  |  nulls: {listings[col].isnull().sum():,}")
print()

# ============================================================
# STEP 4: Ensure numeric fields are properly typed
# ============================================================
print("=" * 55)
print("STEP 4: NUMERIC TYPE CONFIRMATION")
print("=" * 55)

# Why: some numeric fields may be read as object due to mixed content
numeric_fields = [
    "ClosePrice", "ListPrice", "OriginalListPrice",
    "LivingArea", "LotSizeAcres", "BedroomsTotal",
    "BathroomsTotalInteger", "DaysOnMarket", "YearBuilt",
    "Latitude", "Longitude"
]

for col in numeric_fields:
    if col in sold.columns:
        sold[col] = pd.to_numeric(sold[col], errors="coerce")
    if col in listings.columns:
        listings[col] = pd.to_numeric(listings[col], errors="coerce")

print("Numeric fields confirmed for sold and listings:")
for col in numeric_fields:
    sold_dtype     = str(sold[col].dtype)     if col in sold.columns     else "N/A"
    listings_dtype = str(listings[col].dtype) if col in listings.columns else "N/A"
    print(f"  {col:25s}  sold: {sold_dtype:10s}  listings: {listings_dtype}")
print()

# ============================================================
# STEP 5: Handle missing values
# ============================================================
print("=" * 55)
print("STEP 5: HANDLE MISSING VALUES")
print("=" * 55)

# Why: records missing all core price/size fields are not usable for analysis
# Strategy: flag rows where ALL of the key numeric fields are null simultaneously
# (rather than dropping on any single null, which would lose too many records)

key_fields = ["ClosePrice", "LivingArea", "DaysOnMarket"]

for df_name, df in [("sold", sold), ("listings", listings)]:
    available = [f for f in key_fields if f in df.columns]
    all_null  = df[available].isnull().all(axis=1).sum()
    print(f"  [{df_name}] Rows where ALL of {available} are null: {all_null:,}")

print()
print("Strategy: retain rows with at least one key field present.")
print("Records missing ALL key fields will be dropped.")
print()

sold_before = len(sold)
available_sold = [f for f in key_fields if f in sold.columns]
sold = sold[~sold[available_sold].isnull().all(axis=1)].copy()
print(f"  [SOLD]     rows before: {sold_before:,}  ->  after: {len(sold):,}  "
      f"(dropped: {sold_before - len(sold):,})")

listings_before = len(listings)
available_listings = [f for f in key_fields if f in listings.columns]
listings = listings[~listings[available_listings].isnull().all(axis=1)].copy()
print(f"  [LISTINGS] rows before: {listings_before:,}  ->  after: {len(listings):,}  "
      f"(dropped: {listings_before - len(listings):,})")
print()

# ============================================================
# STEP 6: Flag invalid numeric values
# ============================================================
print("=" * 55)
print("STEP 6: FLAG INVALID NUMERIC VALUES")
print("=" * 55)

# Why: flag first, remove after — preserves raw context while
# clearly identifying data quality issues

def flag_invalid_numerics(df, label):
    df["flag_invalid_close_price"] = df["ClosePrice"] <= 0
    df["flag_invalid_living_area"] = df["LivingArea"]  <= 0
    df["flag_negative_dom"]        = df["DaysOnMarket"] < 0
    df["flag_invalid_bedrooms"]    = df["BedroomsTotal"] < 0
    df["flag_invalid_bathrooms"]   = df["BathroomsTotalInteger"] < 0

    flags = [
        "flag_invalid_close_price",
        "flag_invalid_living_area",
        "flag_negative_dom",
        "flag_invalid_bedrooms",
        "flag_invalid_bathrooms",
    ]

    print(f"\n--- {label}: Invalid Numeric Flags ---")
    for f in flags:
        count = df[f].sum()
        pct   = count / len(df) * 100
        print(f"  {f:35s}  {count:>7,}  ({pct:.2f}%)")
    return df

sold     = flag_invalid_numerics(sold,     "SOLD")
listings = flag_invalid_numerics(listings, "LISTINGS")
print()

# ============================================================
# STEP 7: Date consistency flags
# ============================================================
print("=" * 55)
print("STEP 7: DATE CONSISTENCY FLAGS")
print("=" * 55)

# Why: logical order must be:
# ListingContractDate → PurchaseContractDate → CloseDate
# Violations indicate data entry errors

def flag_date_consistency(df, label):
    has_listing  = "ListingContractDate"  in df.columns
    has_purchase = "PurchaseContractDate" in df.columns
    has_close    = "CloseDate"            in df.columns

    # CloseDate before ListingContractDate
    df["listing_after_close_flag"] = (
        df["CloseDate"] < df["ListingContractDate"]
    ) if (has_listing and has_close) else False

    # CloseDate before PurchaseContractDate
    df["purchase_after_close_flag"] = (
        df["CloseDate"] < df["PurchaseContractDate"]
    ) if (has_purchase and has_close) else False

    # PurchaseContractDate before ListingContractDate
    df["negative_timeline_flag"] = (
        df["PurchaseContractDate"] < df["ListingContractDate"]
    ) if (has_listing and has_purchase) else False

    date_flags = [
        "listing_after_close_flag",
        "purchase_after_close_flag",
        "negative_timeline_flag",
    ]

    print(f"\n--- {label}: Date Consistency Flag Counts ---")
    for f in date_flags:
        count = df[f].sum()
        pct   = count / len(df) * 100
        print(f"  {f:35s}  {count:>7,}  ({pct:.2f}%)")
    return df

sold     = flag_date_consistency(sold,     "SOLD")
listings = flag_date_consistency(listings, "LISTINGS")
print()

# ============================================================
# STEP 8: Geographic data quality flags
# ============================================================
print("=" * 55)
print("STEP 8: GEOGRAPHIC DATA QUALITY FLAGS")
print("=" * 55)

# Why: invalid coordinates break map-based Tableau visualizations
# California: Latitude 32-42.5N, Longitude -124.5 to -114.0 (always negative)

def flag_geo_issues(df, label):
    has_lat = "Latitude"  in df.columns
    has_lon = "Longitude" in df.columns

    if has_lat and has_lon:
        df["flag_missing_coords"]     = df["Latitude"].isnull() | df["Longitude"].isnull()
        df["flag_zero_coords"]        = (df["Latitude"] == 0)   | (df["Longitude"] == 0)
        df["flag_positive_longitude"] = df["Longitude"] > 0

        valid_mask = ~df["flag_missing_coords"] & ~df["flag_zero_coords"]
        df["flag_out_of_state_coords"] = False
        df.loc[valid_mask, "flag_out_of_state_coords"] = (
            (df.loc[valid_mask, "Latitude"]  < LAT_MIN) |
            (df.loc[valid_mask, "Latitude"]  > LAT_MAX) |
            (df.loc[valid_mask, "Longitude"] < LON_MIN) |
            (df.loc[valid_mask, "Longitude"] > LON_MAX)
        )

        df["flag_any_geo_issue"] = (
            df["flag_missing_coords"]     |
            df["flag_zero_coords"]        |
            df["flag_positive_longitude"] |
            df["flag_out_of_state_coords"]
        )
    else:
        for f in ["flag_missing_coords", "flag_zero_coords",
                  "flag_positive_longitude", "flag_out_of_state_coords",
                  "flag_any_geo_issue"]:
            df[f] = False
        print(f"  [{label}] WARNING: Latitude/Longitude columns not found.")

    geo_flags = [
        "flag_missing_coords",
        "flag_zero_coords",
        "flag_positive_longitude",
        "flag_out_of_state_coords",
        "flag_any_geo_issue",
    ]

    print(f"\n--- {label}: Geographic Data Quality Summary ---")
    for f in geo_flags:
        count = df[f].sum()
        pct   = count / len(df) * 100
        print(f"  {f:35s}  {count:>7,}  ({pct:.2f}%)")
    return df

sold     = flag_geo_issues(sold,     "SOLD")
listings = flag_geo_issues(listings, "LISTINGS")
print()

# ============================================================
# STEP 9: Final summary (before/after row counts)
# ============================================================
print("=" * 55)
print("STEP 9: FINAL SUMMARY")
print("=" * 55)

print(f"SOLD:")
print(f"  Original rows  : {sold_original_rows:>7,}")
print(f"  Final rows     : {len(sold):>7,}")
print(f"  Total removed  : {sold_original_rows - len(sold):>7,}")
print(f"  Final columns  : {sold.shape[1]}")
print()

print(f"LISTINGS:")
print(f"  Original rows  : {listings_original_rows:>7,}")
print(f"  Final rows     : {len(listings):>7,}")
print(f"  Total removed  : {listings_original_rows - len(listings):>7,}")
print(f"  Final columns  : {listings.shape[1]}")
print()

print("Date field type confirmation (sold):")
for col in ["CloseDate", "PurchaseContractDate",
            "ListingContractDate", "ContractStatusChangeDate"]:
    if col in sold.columns:
        print(f"  {col:35s}  {sold[col].dtype}")
print()

# ============================================================
# STEP 10: Save outputs
# ============================================================
print("=" * 55)
print("STEP 10: SAVING OUTPUT FILES")
print("=" * 55)

# File 1: Full flagged dataset (all records, with all flag columns)
# Use this to review data quality issues
sold_flagged_path     = os.path.join(OUTPUT_FOLDER, "sold_flagged.csv")
listings_flagged_path = os.path.join(OUTPUT_FOLDER, "listings_flagged.csv")

sold.to_csv(sold_flagged_path,         index=False)
listings.to_csv(listings_flagged_path, index=False)

print(f"sold_flagged.csv     saved -> {sold_flagged_path}")
print(f"listings_flagged.csv saved -> {listings_flagged_path}")
print()

# File 2: Clean analysis-ready dataset
# Remove records with invalid numeric values and geo issues
# Date-flagged records are kept (they may still have valid price/area data)
flag_cols_to_exclude = [
    "flag_invalid_close_price",
    "flag_invalid_living_area",
    "flag_negative_dom",
    # flag_any_geo_issue is NOT excluded here
    # geographic issues are flagged for auditing only, not deleted
]

def build_clean_dataset(df, label):
    before = len(df)
    mask = pd.Series(True, index=df.index)
    for f in flag_cols_to_exclude:
        if f in df.columns:
            mask = mask & ~df[f]
    clean = df[mask].copy()
    print(f"  [{label}] Flagged dataset : {before:>7,} rows")
    print(f"  [{label}] Clean dataset   : {len(clean):>7,} rows")
    print(f"  [{label}] Removed         : {before - len(clean):>7,} rows")
    return clean

sold_clean     = build_clean_dataset(sold,     "SOLD")
listings_clean = build_clean_dataset(listings, "LISTINGS")
print()

sold_clean_path     = os.path.join(OUTPUT_FOLDER, "sold_clean.csv")
listings_clean_path = os.path.join(OUTPUT_FOLDER, "listings_clean.csv")

sold_clean.to_csv(sold_clean_path,         index=False)
listings_clean.to_csv(listings_clean_path, index=False)

print(f"sold_clean.csv     saved -> {sold_clean_path}")
print(f"listings_clean.csv saved -> {listings_clean_path}")
print()
print("Week 4-5 complete!")
