# ============================================================
# STEP 3: School District Join (using Latitude / Longitude)
# ============================================================
print("=" * 55)
print("STEP 3: SCHOOL DISTRICT JOIN")
print("=" * 55)

try:
    import geopandas as gpd
    from shapely.geometry import Point

    # Download GeoJSON from CA Open Data
    SCHOOL_DISTRICT_URL = (
        "https://gis.data.ca.gov/api/download/v1/items/"
        "b0e3b936426a47ce9d9a2e77e2bb86cc/geojson?layers=0"
    )

    print("Downloading California school district boundaries...")
    districts = gpd.read_file(SCHOOL_DISTRICT_URL)
    print(f"School districts loaded: {len(districts):,} records")
    print(f"District columns: {list(districts.columns[:8])}")
    print()

    # Build GeoDataFrame from sold coordinates
    sold_valid_geo = sold.dropna(subset=["Latitude", "Longitude"]).copy()
    geometry = [
        Point(lon, lat)
        for lon, lat in zip(sold_valid_geo["Longitude"], sold_valid_geo["Latitude"])
    ]
    sold_gdf = gpd.GeoDataFrame(sold_valid_geo, geometry=geometry, crs="EPSG:4326")

    # Reproject districts to match CRS
    districts = districts.to_crs("EPSG:4326")

    # Identify the district name column
    name_candidates = ["DistrictName", "DISTNAME", "NAME", "District_Name", "LEAName"]
    district_name_col = next(
        (c for c in name_candidates if c in districts.columns), None
    )
    if district_name_col is None:
        district_name_col = districts.columns[1]
        print(f"Using column '{district_name_col}' as district name.")

    # Keep only Unified districts to avoid duplicates
    # (elementary + high school districts overlap the same area)
    if "DistrictType" in districts.columns:
        unified = districts[districts["DistrictType"] == "Unified"].copy()
        print(f"Filtered to Unified districts: {len(unified):,}")
    else:
        unified = districts.copy()
        print("DistrictType column not found, using all districts.")

    # Spatial join
    print("Running spatial join...")
    joined = gpd.sjoin(
        sold_gdf,
        unified[[district_name_col, "geometry"]],
        how="left",
        predicate="within"
    )

    # Map results back to sold
    sold["school_district"] = None
    sold.loc[sold_valid_geo.index, "school_district"] = (
        joined[district_name_col].values
    )

    matched     = sold["school_district"].notna().sum()
    not_matched = sold["school_district"].isna().sum()
    print(f"School district matched     : {matched:,}")
    print(f"School district not matched : {not_matched:,}")
    print()

    print("--- Top 10 School Districts by Transaction Count ---")
    print(sold["school_district"].value_counts().head(10).to_string())
    print()

except ImportError:
    print("geopandas not installed.")
    print("Install with: pip install geopandas")
    print("Skipping school district join — school_district column set to null.\n")
    sold["school_district"] = None

except Exception as e:
    print(f"School district join failed: {e}")
    print("Skipping — school_district column set to null.\n")
    sold["school_district"] = None

# ============================================================
# STEP 4: Segment Analysis
# ============================================================
print("=" * 55)
print("STEP 4: SEGMENT ANALYSIS")
print("=" * 55)

def segment_summary(df, group_col, label):
    """Generate summary stats grouped by a single dimension."""
    if group_col not in df.columns:
        print(f"  [{label}] Column '{group_col}' not found — skipping.")
        return

    summary = (
        df.groupby(group_col)
        .agg(
            transaction_count = ("ClosePrice",              "count"),
            median_close_price = ("ClosePrice",             "median"),
            avg_close_price    = ("ClosePrice",             "mean"),
            median_ppsf        = ("price_per_sqft",         "median"),
            median_dom         = ("DaysOnMarket",           "median"),
            avg_price_ratio    = ("price_ratio",            "mean"),
        )
        .sort_values("transaction_count", ascending=False)
        .round(2)
    )

    print(f"\n--- {label}: Segment Summary (top 10) ---")
    print(summary.head(10).to_string())
    print()
    return summary

# Segment 1: PropertyType and PropertySubType
seg_subtype  = segment_summary(sold, "PropertySubType",  "PropertySubType")

# Segment 2: CountyOrParish
seg_county   = segment_summary(sold, "CountyOrParish",   "CountyOrParish")

# Segment 3: MLSAreaMajor
seg_mls_area = segment_summary(sold, "MLSAreaMajor",     "MLSAreaMajor")

# Segment 4: ListOfficeName (competitive intelligence)
seg_list_off = segment_summary(sold, "ListOfficeName",   "ListOfficeName")

# Segment 5: BuyerOfficeName (competitive intelligence)
seg_buy_off  = segment_summary(sold, "BuyerOfficeName",  "BuyerOfficeName")

# Segment 6: YrMo time series
seg_yrmo     = segment_summary(sold, "close_yrmo",       "YrMo (monthly trend)")

