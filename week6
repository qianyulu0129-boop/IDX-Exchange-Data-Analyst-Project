# ============================================================
# STEP 1: Load clean dataset from Week 4-5
# ============================================================
print("=" * 55)
print("STEP 1: LOADING DATASET")
print("=" * 55)

sold = pd.read_csv(os.path.join(DATA_FOLDER, "sold_clean.csv"), low_memory=False)

print(f"sold_clean.csv loaded: {len(sold):>7,} rows  x  {sold.shape[1]} columns")
print()

# Convert date fields to datetime
date_fields = ["CloseDate", "PurchaseContractDate", "ListingContractDate"]
for col in date_fields:
    if col in sold.columns:
        sold[col] = pd.to_datetime(sold[col], format="mixed", errors="coerce")

# Convert numeric fields
numeric_fields = [
    "ClosePrice", "OriginalListPrice", "LivingArea", "DaysOnMarket"
]
for col in numeric_fields:
    if col in sold.columns:
        sold[col] = pd.to_numeric(sold[col], errors="coerce")

print("Date and numeric fields confirmed.\n")

# ============================================================
# STEP 2: Feature Engineering — 7 Key Metrics
# ============================================================
print("=" * 55)
print("STEP 2: FEATURE ENGINEERING")
print("=" * 55)

# --- Metric 1: Price Ratio (negotiation strength) ---
# Formula: ClosePrice / OriginalListPrice
# Purpose: measures how close the final price was to the original asking price
sold["price_ratio"] = (
    sold["ClosePrice"] / sold["OriginalListPrice"]
).round(4)
print(f"price_ratio          created  |  nulls: {sold['price_ratio'].isnull().sum():,}")

# --- Metric 2: Price Per Square Foot (PPSF) ---
# Formula: ClosePrice / LivingArea
# Purpose: normalizes price across properties of different sizes
sold["price_per_sqft"] = (
    sold["ClosePrice"] / sold["LivingArea"]
).round(2)
print(f"price_per_sqft       created  |  nulls: {sold['price_per_sqft'].isnull().sum():,}")

# --- Metric 3: Days on Market ---
# Formula: raw DaysOnMarket field (already exists)
# Purpose: time-to-sell indicator
print(f"days_on_market       exists   |  nulls: {sold['DaysOnMarket'].isnull().sum():,}")

# --- Metric 4: Year / Month / YrMo (time-series variables) ---
# Formula: derived from CloseDate
# Purpose: enables monthly and yearly trend analysis in Tableau
sold["close_year"]  = sold["CloseDate"].dt.year
sold["close_month"] = sold["CloseDate"].dt.month
sold["close_yrmo"]  = sold["CloseDate"].dt.to_period("M").astype(str)
print(f"close_year/month/yrmo created  |  nulls: {sold['close_yrmo'].isnull().sum():,}")

# --- Metric 5: Close to Original List Ratio ---
# Formula: ClosePrice / OriginalListPrice (same as price_ratio)
# Purpose: explicitly captures full price reduction history vs. original ask
sold["close_to_orig_list_ratio"] = sold["price_ratio"]
print(f"close_to_orig_list_ratio created (same as price_ratio)")

# --- Metric 6: Listing to Contract Days ---
# Formula: PurchaseContractDate - ListingContractDate
# Purpose: measures time from listing to accepted offer
sold["listing_to_contract_days"] = (
    sold["PurchaseContractDate"] - sold["ListingContractDate"]
).dt.days
print(f"listing_to_contract_days created  |  nulls: {sold['listing_to_contract_days'].isnull().sum():,}")

# --- Metric 7: Contract to Close Days ---
# Formula: CloseDate - PurchaseContractDate
# Purpose: measures escrow and closing period duration
sold["contract_to_close_days"] = (
    sold["CloseDate"] - sold["PurchaseContractDate"]
).dt.days
print(f"contract_to_close_days   created  |  nulls: {sold['contract_to_close_days'].isnull().sum():,}")

print()

# --- Sample output table ---
print("--- Sample Output: New Metric Columns (5 rows) ---")
