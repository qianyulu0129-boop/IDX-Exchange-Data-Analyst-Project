# ============================================================
# HELPER: Load one file, drop latfilled/lonfilled if present
# ============================================================

def load_file(path):
    """
    Load a single monthly CSV. If it's a '_filled' file that still
    has the latfilled/lonfilled columns, drop them so all monthly
    files end up with the same column structure before concatenation.
    """
    df = pd.read_csv(path, low_memory=False)

    extra_cols = [c for c in ["latfilled", "lonfilled"] if c in df.columns]
    if extra_cols:
        df = df.drop(columns=extra_cols)
        print(f"  Loaded {os.path.basename(path):35s}  rows: {len(df):>7,}  "
              f"(dropped columns: {extra_cols})")
    else:
        print(f"  Loaded {os.path.basename(path):35s}  rows: {len(df):>7,}")

    return df


# ============================================================
# HELPER: Load, concatenate, filter, and save
# ============================================================

def process_dataset(files, label, output_filename):
    """
    Load all monthly CSVs for one dataset type, concatenate them,
    filter to Residential only, and save the result as a fixed
    filename (sold.csv / listings.csv) that gets overwritten/updated
    each week as new monthly files are added to the folder.
    """
    if not files:
        print(f"[{label}] WARNING: No files found - skipping.\n")
        return None

    # --- Load each monthly file (auto-drops latfilled/lonfilled) ---
    dfs = [load_file(f) for f in files]

    # --- Concatenate ---
    combined = pd.concat(dfs, ignore_index=True)
    rows_before = len(combined)
    print(f"\n[{label}] Row count AFTER concatenation   : {rows_before:>7,}")

    # --- Filter PropertyType == 'Residential' ---
    residential = combined[combined["PropertyType"] == "Residential"].copy()
    rows_after = len(residential)
    print(f"[{label}] Row count AFTER Residential filter: {rows_after:>7,}")
    print(f"[{label}] Rows removed (non-Residential)     : {rows_before - rows_after:>7,}")

    # --- Save output (fixed filename - this IS the cumulative file) ---
    output_path = os.path.join(OUTPUT_FOLDER, output_filename)
    residential.to_csv(output_path, index=False)
    print(f"[{label}] Saved -> {output_path}\n")

    return residential


