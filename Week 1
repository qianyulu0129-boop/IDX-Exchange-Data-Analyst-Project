"""
Week 1 - Monthly Dataset Aggregation
"""

import pandas as pd
import glob
import os

# ============================================================
# CONFIG
# ============================================================
DATA_FOLDER = "."       # Folder where your CSV files are stored
OUTPUT_FOLDER = "."     # Folder where output CSVs will be saved

os.makedirs(OUTPUT_FOLDER, exist_ok=True)

# ============================================================
# STEP 1: Discover all monthly files automatically
# ============================================================

sold_files    = sorted(glob.glob(os.path.join(DATA_FOLDER, "CRMLSSold*.csv")))
listing_files = sorted(glob.glob(os.path.join(DATA_FOLDER, "CRMLSListing*.csv")))

print("=" * 55)
print("FILES DISCOVERED")
print("=" * 55)
print(f"Sold files    ({len(sold_files)}):")
for f in sold_files:
    print(f"  {os.path.basename(f)}")

print(f"Listing files ({len(listing_files)}):")
for f in listing_files:
    print(f"  {os.path.basename(f)}")
print()

# ============================================================
# HELPER: Load, concatenate, filter, and save
# ============================================================

def process_dataset(files, label, output_filename):
    """
    Load all monthly CSVs for one dataset type, concatenate them,
    filter to Residential only, and save the result.
    """
    if not files:
        print(f"[{label}] WARNING: No files found — skipping.\n")
        return None

    # --- Load each monthly file ---
    dfs = []
    for f in files:
        df = pd.read_csv(f, low_memory=False)
        dfs.append(df)
        print(f"  Loaded {os.path.basename(f):35s}  rows: {len(df):>7,}")

    # --- Concatenate ---
    combined = pd.concat(dfs, ignore_index=True)
    rows_before = len(combined)
    print(f"\n[{label}] Row count AFTER concatenation  : {rows_before:>7,}")

    # --- Filter PropertyType == 'Residential' ---
    residential = combined[combined["PropertyType"] == "Residential"].copy()
    rows_after = len(residential)
    print(f"[{label}] Row count AFTER Residential filter: {rows_after:>7,}")
    print(f"[{label}] Rows removed (non-Residential)    : {rows_before - rows_after:>7,}")

    # --- Save output ---
    output_path = os.path.join(OUTPUT_FOLDER, output_filename)
    residential.to_csv(output_path, index=False)
    print(f"[{label}] Saved -> {output_path}\n")

    return residential


# ============================================================
# STEP 2: Process SOLD dataset
# ============================================================

print("=" * 55)
print("SOLD DATASET")
print("=" * 55)
sold_residential = process_dataset(
    files           = sold_files,
    label           = "SOLD",
    output_filename = "sold_residential_combined.csv"
)

# ============================================================
# STEP 3: Process LISTING dataset
# ============================================================

print("=" * 55)
print("LISTING DATASET")
print("=" * 55)
listing_residential = process_dataset(
    files           = listing_files,
    label           = "LISTING",
    output_filename = "listing_residential_combined.csv"
)

# ============================================================
# STEP 4: Summary
# ============================================================

print("=" * 55)
print("SUMMARY")
print("=" * 55)
if sold_residential is not None:
    print(f"Sold Residential     : {len(sold_residential):>7,} rows  |  "
          f"{sold_residential['CountyOrParish'].nunique()} counties  |  "
          f"{sold_residential['City'].nunique()} cities")
    print(f"  Date range : {sold_residential['CloseDate'].min()}  ->  "
          f"{sold_residential['CloseDate'].max()}")
    print(f"  ClosePrice : min ${sold_residential['ClosePrice'].min():>12,.0f}  "
          f"max ${sold_residential['ClosePrice'].max():>12,.0f}  "
          f"median ${sold_residential['ClosePrice'].median():>12,.0f}")

if listing_residential is not None:
    print(f"Listing Residential  : {len(listing_residential):>7,} rows  |  "
          f"{listing_residential['CountyOrParish'].nunique()} counties  |  "
          f"{listing_residential['City'].nunique()} cities")

print()
print("Week 1 complete!")
