DATA_FOLDER = "."       # Folder where your monthly CSV files are stored
OUTPUT_FOLDER = "."     # Folder where sold.csv / listings.csv will be saved

# Full expected date range for this project
START_YEAR_MONTH = (2024, 1)
END_YEAR_MONTH   = (2026, 5)   # update each time a new month closes

os.makedirs(OUTPUT_FOLDER, exist_ok=True)


def expected_months(start_ym, end_ym):
    """Generate YYYYMM strings from start to end, inclusive."""
    months = []
    y, m = start_ym
    while (y, m) <= end_ym:
        months.append(f"{y}{m:02d}")
        y, m = (y + 1, 1) if m == 12 else (y, m + 1)
    return months


def check_coverage(files, label):
    """Compare which months are present in `files` vs. the full expected range."""
    found_months = set()
    for f in files:
        match = re.search(r"(\d{6})", os.path.basename(f))
        if match:
            found_months.add(match.group(1))

    all_months = expected_months(START_YEAR_MONTH, END_YEAR_MONTH)
    missing = [m for m in all_months if m not in found_months]

    print(f"[{label}] Expected months : {len(all_months)} "
          f"({all_months[0]} to {all_months[-1]})")
    print(f"[{label}] Found months    : {len(found_months)}")
    if missing:
        print(f"[{label}] MISSING months  : {len(missing)} -> {missing}")
    else:
        print(f"[{label}] All months present - data is complete.")
    print()

